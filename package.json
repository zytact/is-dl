{
  "name": "is-dl",
  "private": true,
  "scripts": {
    "dev": "vp run -F @repo/api -F @repo/web dev",
    "dev:api": "vp run --filter @repo/api dev",
    "dev:web": "vp run --filter @repo/web dev",
    "dev:tui": "bash scripts/start-api-tui.sh dev",
    "dev:api:tui": "vp run dev:tui",
    "start": "vp run -F @repo/api -F @repo/web start",
    "start:api": "vp run --filter @repo/api start",
    "start:web": "vp run --filter @repo/web start",
    "start:tui": "bash scripts/start-api-tui.sh start",
    "start:api:tui": "vp run start:tui",
    "launch": "vp run start:tui",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "vp run -r typecheck",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.6.0"
}
